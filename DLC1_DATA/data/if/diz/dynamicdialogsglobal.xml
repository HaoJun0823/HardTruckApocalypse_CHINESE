<?xml version="1.0" encoding="windows-1251" standalone="yes" ?>
<DialogsResource><!--Root-->
	<Reply
		name="Dynamic00"
		text="I welcome you, Vagrant."
		role="NPC"
		scriptResult="ConversationWnd:ShowDynamicQuestsMenu()"
		nextReplies="EndDlg2 Dlg_pl_000020" />

	<Reply
		name="Dlg_pl_000020"
		text="I apologize, it seems as if I was mistaken."
		role="PLAYER"
		scriptCondition="GetCurNpc():HasNotTakenDynamicQuests()"
		scriptResult="ConversationWnd:EndConversation()" />

	<Reply
		name="Dynamic00_plYes0"
		text="Yes."
		role="PLAYER"
		scriptResult="ConversationWnd:GetCurrentDynamicQuest():Take(); ConversationWnd:EndConversation()" />

	<Reply
		name="Dynamic00_plNo0"
		text="No."
		role="PLAYER"
		scriptResult="ConversationWnd:EndConversation()" />

	<Reply
		name="Dynamic00_Destroy00"
		text="I'm looking for a job, maybe you will find something for me?"
		role="PLAYER"
		nextReplies="Dynamic00_Destroy00_npc0" />

	<Reply
		name="Dynamic00_DestroyTimelimited00"
		text="I'm looking for a job but not for long."
		role="PLAYER"
		nextReplies="Dynamic00_Destroy00_npc0" />

	<Reply
		name="Dynamic00_Destroy00_npc0"
		text="In the neighborhood a recidivist thief lives. Reward for his hand is - %3d. Will you take this mission?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Destroy01"
		text="What is about the work?"
		role="PLAYER"
		nextReplies="Dynamic00_Destroy01_npc0" />

	<Reply
		name="Dynamic00_DestroyTimelimited01"
		text="What's about part time job here?"
		role="PLAYER"
		nextReplies="Dynamic00_Destroy01_npc0" />

	<Reply
		name="Dynamic00_Destroy01_npc0"
		text="Somebody burns out our seeds and poisons water well.The most probably it is enemy spy. Kill him and you will get %3d. Do you agree?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Destroy02"
		text="Do you have a job for me?"
		role="PLAYER"
		nextReplies="Dynamic00_Destroy02_npc0" />

	<Reply
		name="Dynamic00_DestroyTimelimited02"
		text="Do you have some mission for me?"
		role="PLAYER"
		nextReplies="Dynamic00_Destroy02_npc0" />

	<Reply
		name="Dynamic00_Destroy02_npc0"
		text="In the outskirts drives one madman, he sets ambushes and frightens villagers. He is not dangerous but people complain. Kill him and you will get %3d. Will you help us?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Reach00"
		text="I would like to know about the job."
		role="PLAYER"
		nextReplies="Dynamic00_Reach00_npc0" />

	<Reply
		name="Dynamic00_ReachTimelimited00"
		text="I would like to find easy work for good money."
		role="PLAYER"
		nextReplies="Dynamic00_Reach00_npc0" />

	<Reply
		name="Dynamic00_Reach00_npc0"
		text="It is necessary to take some research data and pieces to settlement %2n. You will be paid at the place. %3d is not bad money for this mission. Will you deliver this cargo?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Reach01"
		text="I was said to be able to get a job here?"
		role="PLAYER"
		nextReplies="Dynamic00_Reach01_npc0" />

	<Reply
		name="Dynamic00_ReachTimelimited01"
		text="An acute and fast man is said to be able to find a job here."
		role="PLAYER"
		nextReplies="Dynamic00_Reach01_npc0" />

	<Reply
		name="Dynamic00_Reach01_npc0"
		text="We have a package for the settlemen %2n. Deliver it when you will go by this settlement. It is not an urgent case. You will be paid %3d. Can I reckon on you?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_ReachComplete00"
		text="Is it you whom I have to deliver this package?"
		role="PLAYER"
		nextReplies="Dynamic00_ReachComplete00_npc0" />

	<Reply
		name="Dynamic00_ReachComplete00_npc0"
		text="Yes, here. Is everything in its place?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Convoy00"
		text="Maybe I can find some work here?"
		role="PLAYER"
		nextReplies="Dynamic00_Convoy00_npc0" />

	<Reply
		name="Dynamic00_ConvoyTimelimited00"
		text="I need money, so I can take any mission you give me."
		role="PLAYER"
		nextReplies="Dynamic00_Convoy00_npc0" />

	<Reply
		name="Dynamic00_Convoy00_npc0"
		text="Ok. It is very dangerous to drive alone but one of my friends need go to %2n. Escort him and you will be paid %3d at arrival. Will you go?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Convoy01"
		text="Can you tell me anything about a job?"
		role="PLAYER"
		nextReplies="Dynamic00_Convoy01_npc0" />

	<Reply
		name="Dynamic00_ConvoyTimelimited01"
		text="Can you tell me anything about part time missions?"
		role="PLAYER"
		nextReplies="Dynamic00_Convoy01_npc0" />

	<Reply
		name="Dynamic00_Convoy01_npc0"
		text="Here one man trades with the neighboring city and carries there commodity samples. Escort him to %2n and trace for the tailers. Oh, yeah! The reward is %3d. Are you ready to escort him?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="EndDlg1"
		text="I need money. What is heard about the job in this city?"
		role="PLAYER"
		scriptResult="ConversationWnd:EndConversation()"
		nextReplies="Dlg_npc_000017" />

	<Reply
		name="EndDlg2"
		text="What's the news?"
		role="PLAYER"
		scriptCondition="not GetCurNpc():HasNotTakenDynamicQuests()"
		nextReplies="Dlg_npc_000017" />

	<Reply
		name="Dlg_npc_000017"
		text="In general there is nothing new. Everything is quiet for many days."
		role="NPC"
		nextReplies="Dlg_pl_000018" />

	<Reply
		name="Dlg_pl_000018"
		text="Ok, see you next time."
		role="PLAYER"
		scriptResult="ConversationWnd:EndConversation()" />

	<Reply
		name="Dynamic00_Peace00"
		text="I have a problem, I have differences with with group %2bNNN"
		role="PLAYER"
		nextReplies="Dynamic00_Peace00_npc0" />

	<Reply
		name="Dynamic00_Peace00_npc0"
		text="I think you have tried a lot that %2b declared you its enemyNNN I have some friends and for %3d percent of your money I can talk to people from the city council. Do you have money about you?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Peace01"
		text="I need help. %2b and I can't reach an agreement on one question and nowNNN"
		role="PLAYER"
		nextReplies="Dynamic00_Peace01_npc0" />

	<Reply
		name="Dynamic00_Peace01_npc0"
		text="I know that %2b don't want to deal with you. For a modest reward %3d percent of your money I can help you to acquire authority among them. Have you prepared the money?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Hunt00"
		text="I think that somebody has offered a job here."
		role="PLAYER"
		nextReplies="Dynamic00_Hunt00_npc0" />

	<Reply
		name="Dynamic00_HuntTimelimited00"
		text="I think, somebody has offered a soft job here?"
		role="PLAYER"
		nextReplies="Dynamic00_Hunt00_npc0" />

	<Reply
		name="Dynamic00_Hunt00_npc0"
		text="Hunting season for bandits is declared. Every destroyed vehicle will bring you %3d. All money will be given to you after the end of the season. Should I register you?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Hunt01"
		text="I think in this big city there is some job for me?"
		role="PLAYER"
		nextReplies="Dynamic00_Hunt01_npc0" />

	<Reply
		name="Dynamic00_HuntTimelimited01"
		text="I think in this big city there is some profitable job for me?"
		role="PLAYER"
		nextReplies="Dynamic00_Hunt01_npc0" />

	<Reply
		name="Dynamic00_Hunt01_npc0"
		text="Bandits have lost all the shame! They invade our territory and come into our stocks. It need teach them a good lesson. Kill a couple of them to terrify them. Keep the time and you will get %3d for every one of them. Will you take risks?"
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_Drugs00"
		text="Maybe you have something... Do you understand what I mean?!"
		role="PLAYER"
		nextReplies="Dynamic00_Drugs00_npc0" />

	<Reply
		name="Dynamic00_Drugs00_npc0"
		text="Ok, quiet. Here is a package. I think you have realized that they are smuggled goods of premium quality. It costs %3d, but you can sell it far more expensive... if you stay alive. Will you buy it?"
		role="NPC"
		nextReplies="Dynamic00_DrugsTake Dynamic00_DrugsNoMoney Dynamic00_plNo0" />

	<Reply
		name="Dynamic00_DrugsNoMoney"
		text="Eh... Keep it for me I will return with the money."
		role="PLAYER"
		scriptCondition="GetPlayerMoney() < ConversationWnd:GetCurrentDynamicQuest():GetReward()"
		scriptResult="ConversationWnd:EndConversation()" />

	<Reply
		name="Dynamic00_DrugsTake"
		text="Give it to me I'll find where to sell it."
		role="PLAYER"
		scriptCondition="GetPlayerMoney() >= ConversationWnd:GetCurrentDynamicQuest():GetReward()"
		scriptResult="ConversationWnd:GetCurrentDynamicQuest():Take(); ConversationWnd:EndConversation()" />

	<Reply
		name="Dynamic00_SellDrugs00"
		text="I would like to sell to some serious people one package."
		role="PLAYER"
		nextReplies="Dynamic00_SellDrugs00_npc0" />

	<Reply
		name="Dynamic00_SellDrugs00_npc0"
		text="Keep quiet, you will attract superfluous attention. How much do you want for it?"
		role="NPC"
		nextReplies="Dynamic00_SellDrugs00_1x Dynamic00_SellDrugs00_1.5x Dynamic00_SellDrugs00_2x" />

	<Reply
		name="Dynamic00_SellDrugs00_1x"
		text="I sell it with no benefit for myself."
		role="PLAYER"
		scriptResult="ConversationWnd:GetCurrentDynamicQuest():SetRewardCoeff(1.0); ConversationWnd:GetCurrentDynamicQuest():Take()"
		nextReplies="Dynamic00_SellDrugs00_try_yes Dynamic00_SellDrugs00_try_no" />

	<Reply
		name="Dynamic00_SellDrugs00_1.5x"
		text="Maybe I can somehow make money on this deal."
		role="PLAYER"
		scriptResult="ConversationWnd:GetCurrentDynamicQuest():SetRewardCoeff(1.5); ConversationWnd:GetCurrentDynamicQuest():Take()"
		nextReplies="Dynamic00_SellDrugs00_try_yes Dynamic00_SellDrugs00_try_no" />

	<Reply
		name="Dynamic00_SellDrugs00_2x"
		text="I sell it for dual price."
		role="PLAYER"
		scriptResult="ConversationWnd:GetCurrentDynamicQuest():SetRewardCoeff(2.0); ConversationWnd:GetCurrentDynamicQuest():Take()"
		nextReplies="Dynamic00_SellDrugs00_try_yes Dynamic00_SellDrugs00_try_no" />

	<Reply
		name="Dynamic00_SellDrugs00_try_yes"
		text="Ok, I'll take it! Here is your well-deserved %3d!"
		role="NPC"
		scriptCondition="not ConversationWnd:GetCurrentDynamicQuest():IsStatusFailed()"
		nextReplies="Dynamic00_SellDrugs00_ok" />

	<Reply
		name="Dynamic00_SellDrugs00_try_no"
		text="What?! How much do you want?! Listen to me, I will take it for no money! Say a word and I will tell the guards what you sell here. Get away from here."
		role="NPC"
		scriptCondition="ConversationWnd:GetCurrentDynamicQuest():IsStatusFailed()"
		nextReplies="Dynamic00_SellDrugs00_ok" />

	<Reply
		name="Dynamic00_SellDrugs00_ok"
		text="Goodbye."
		role="PLAYER"
		scriptResult="ConversationWnd:EndConversation()" />

	<Reply
		name="Dynamic00_Treasure00"
		text="I'm only interested in different ancient artifacts hidden in this region."
		role="PLAYER"
		nextReplies="Dynamic00_Treasure00_npc0" />

	<Reply
		name="Dynamic00_Treasure00_npc0"
		text="I have some information for you. I don't need troubles I have business in the city. I don't have treasure detector in my vehicle. I think you need explore one place here. I can mark it on the map, if you want, of course."
		role="NPC"
		nextReplies="Dynamic00_plYes0 Dynamic00_plNo0" />
</DialogsResource>
